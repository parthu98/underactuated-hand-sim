# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class

# Python virtual environment (if placed inside)
venv/
.venv/
mujoco_env/

# IDE settings and OS-specific files
.vscode/
.idea/
.DS_Store
Thumbs.db

# MuJoCo logs and temporary physics files
MUJOCO_LOG.TXT
*.log
*.tmp

# SSH keys / secrets — never commit
newid
newid.pub
*.pem
id_rsa*

# Ignore specific output files inside plots/ and logs/ but keep the folders
plots/*
!plots/.gitkeep
logs/*
!logs/.gitkeep

# Mocap rig — per-setup calibration (regenerated, not source)
mocap/mocap_calibration.json

# Generated finger models — rebuilt from config.py on every run
high_fidelity/finger.xml
high_fidelity/_finger_fidelity.xml
gripper/gripper.xml
gripper/load_test.xml

# Dual-graph: track only the cross-session memory (context-store.json) and the
# prime/stop scripts. The scanned graph and per-session logs/caches are regenerated
# by graph_scan — ignore them so they don't churn the tree every session.
.dual-graph/run/
.dual-graph/info_graph.json
.dual-graph/symbol_index.json
.dual-graph/graph.dot
.dual-graph/graph.svg
.dual-graph/graph_internal.dot
.dual-graph/graph_internal.svg
.dual-graph/chat_action_graph.json
.dual-graph/mcp_tool_calls.jsonl
.dual-graph/token_log.jsonl
.dual-graph/retrieval_cache.json
PROJECT_MEMORY.md

# GitHub refresh trigger marker (not source)
.github_refresh

# Common Scripts (finger-sweep CV pipeline): raw videos + all generated
# outputs (tracking caches, rendered mp4s) live in a local, auto-created
# folder here, never in git -- see Common Scripts/README.md. The finished
# dataset lives on Google Drive instead.
Common Scripts/Finger Sweep Videos/

# ...but DO track Common Scripts' own VS Code interpreter setting, unlike the
# repo-wide .vscode/ (personal IDE prefs) ignored above -- this one is meant
# to be shared so a fresh clone points at the right venv automatically.
!Common Scripts/.vscode/
!Common Scripts/.vscode/settings.json
